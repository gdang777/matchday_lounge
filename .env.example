# ─────────────────────────────────────────────────────────
# MatchDay Lounge — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Firebase (Client SDK — safe to expose in client apps) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Expo / React Native equivalents (no VITE_ prefix)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=

# ── Firebase Admin SDK (Server-side only — NEVER expose client-side) ──
FIREBASE_PROJECT_ID=matchday-lounge
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or use a service account key file path (local dev only):
GOOGLE_APPLICATION_CREDENTIALS=

# ── Google Cloud ──
GOOGLE_CLOUD_PROJECT=matchday-lounge
GCP_PROJECT_ID=
GCP_REGION=northamerica-northeast1

# ── Cloud Run API ──
API_URL=
PORT=8080
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175

# ── Firebase Data Connect (Cloud SQL) ──
DATABASE_URL=
DATABASE_NAME=matchday_lounge

# ── Anthropic / Claude API ──
CLAUDE_API_KEY=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=

# ── EAS (Expo Application Services) ──
EXPO_TOKEN=

# ── App URLs (production) ──
RESTAURANT_PORTAL_URL=
ADMIN_PANEL_URL=
