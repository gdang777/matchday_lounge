# ─────────────────────────────────────────────────────────
# MatchDay Lounge — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Firebase (Client SDK — safe to expose in client apps) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Expo / React Native equivalents (no VITE_ prefix)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=

# ── Firebase Admin SDK (Server-side only — NEVER expose client-side) ──
FIREBASE_PROJECT_ID=matchday-lounge
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or use a service account key file path (local dev only):
GOOGLE_APPLICATION_CREDENTIALS=

# ── Google Cloud ──
GOOGLE_CLOUD_PROJECT=matchday-lounge
GCP_PROJECT_ID=
GCP_REGION=northamerica-northeast1

# ── Cloud Run API ──
API_URL=
PORT=8080
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175

# ── Firebase Data Connect (Cloud SQL) ──
DATABASE_URL=
DATABASE_NAME=matchday_lounge

# ── Anthropic / Claude API ──
# Used by: services/api (AI Concierge) AND functions/ (Match Day Alerts dispatcher)
# For Cloud Functions, set as a Firebase secret:
#   firebase functions:secrets:set CLAUDE_API_KEY
CLAUDE_API_KEY=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — create these in your Stripe Dashboard under Products
# Fan Pro subscription
STRIPE_PRO_PRICE_ID=price_xxx          # e.g. price_1ABC...  ($9.99/month)

# Restaurant boost tiers
STRIPE_FEATURED_PRICE_ID=price_xxx     # e.g. price_1DEF...  ($79/month)
STRIPE_PREMIUM_PRICE_ID=price_xxx      # e.g. price_1GHI...  ($149/month)

# Checkout redirect URLs (where Stripe sends users after payment completes/cancels)
STRIPE_SUCCESS_URL=https://yourapp.com/?checkout=success
STRIPE_CANCEL_URL=https://yourapp.com/?checkout=cancelled

# ── Match Data Ingestion (Cloud Functions) ──
# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# Competition code — use WC for FIFA World Cup 2026
FOOTBALL_COMPETITION_CODE=WC
# Shared secret for the manual ingestMatchesManual HTTP trigger
INGEST_ADMIN_SECRET=

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=

# ── EAS (Expo Application Services) ──
EXPO_TOKEN=

# ── App URLs (production) ──
RESTAURANT_PORTAL_URL=
ADMIN_PANEL_URL=

# ── Firebase Emulators (local development only) ──
# Set to "true" to route all Firebase SDK calls to local emulators instead of production.
# Copy these into your local .env / .env.local — do NOT set in production.
VITE_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
USE_FIREBASE_EMULATOR=true          # API service (Node.js / Firebase Admin SDK)

# Emulator host:port values — must match firebase.json emulators block.
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8088
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
VITE_FIREBASE_DATACONNECT_EMULATOR_HOST=localhost:9399

EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8088
EXPO_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
EXPO_PUBLIC_FIREBASE_DATACONNECT_EMULATOR_HOST=localhost:9399

FIREBASE_AUTH_EMULATOR_HOST=localhost:9099       # Used automatically by Admin SDK
FIRESTORE_EMULATOR_HOST=localhost:8088           # Used automatically by Admin SDK
