rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Helper functions
    // ──────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isRestaurantOwner() {
      return hasRole('restaurant_owner');
    }

    // ──────────────────────────────────────────────
    // Users collection
    // ──────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // Match live feed (real-time updates via Firestore)
    // ──────────────────────────────────────────────

    match /match_feeds/{matchId} {
      allow read: if true; // Public
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // Restaurant listings
    // ──────────────────────────────────────────────

    match /restaurants/{restaurantId} {
      allow read: if true; // Public
      allow create: if isRestaurantOwner() || isAdmin();
      allow update: if isAdmin() ||
        (isRestaurantOwner() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // Fan notifications / push tokens
    // ──────────────────────────────────────────────

    match /push_tokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ──────────────────────────────────────────────
    // Deny everything else
    // ──────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
