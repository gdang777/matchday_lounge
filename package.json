{
  "name": "matchday-lounge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:restaurant": "npm run dev --workspace=apps/restaurant",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "emulators": "firebase emulators:start"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
